{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/guard_vendor.py"],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/core_tests.py"],
            "timeout": 180,
            "statusMessage": "Running the aerowave-core tests"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/check_version.py"],
            "timeout": 30,
            "statusMessage": "Checking the version files agree"
          },
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/check_seam.py"],
            "timeout": 30,
            "statusMessage": "Checking the IPC seam"
          }
        ]
      }
    ]
  }
}
